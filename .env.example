# Optional cloud sync (Supabase). Leave unset for local-only mode
# (all data stays in the browser's localStorage).
#
# When configured, the app enables email magic-link sign-in and syncs
# the workbench across devices. The anon key is safe to expose to the
# browser — row-level security scopes every user to their own row.
#
# Copy this file to `.env.local` and fill in a real project's values.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
